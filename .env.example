# Amrutam Telemedicine Frontend - Environment Configuration Template
# Duplicate this file to '.env.local' for local development.
# IMPORTANT: Never commit actual secret keys to version control.

# Backend API Base URL (must end with /api or root)
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# Razorpay Public Key ID (Test key for local development)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_public_key_here
